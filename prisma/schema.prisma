// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Phase 1: Core Accounting
// ------------------------------------------------------

model Account {
  id          String        @id @default(uuid())
  code        String        @unique // e.g. '1001'
  name        String        // e.g. 'Cash'
  type        String        // Asset, Liability, Equity, Revenue, Expense
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[]
}

model JournalEntry {
  id          String        @id @default(uuid())
  date        DateTime      @default(now())
  description String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[]
  // Link automatically generated journal entries back to the invoice that created them
  invoice     Invoice?      @relation("InvoiceJournal")
  // Link automatically generated journal entries back to reconciled bank transactions
  bankTransaction BankTransaction? @relation("BankJournal")
}

model Transaction {
  id             String       @id @default(uuid())
  accountId      String
  journalEntryId String
  debit          Float        @default(0) // In a real system, consider using Decimal/Int
  credit         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
}

// ------------------------------------------------------
// Phase 2: Invoicing & Inventory
// ------------------------------------------------------

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model Item {
  id          String            @id @default(uuid())
  name        String
  description String?
  price       Float             // Selling price
  stockQty    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  invoiceLine InvoiceLineItem[]
}

model Invoice {
  id             String            @id @default(uuid())
  invoiceNumber  String            @unique
  date           DateTime          @default(now())
  customerId     String
  totalAmount    Float             @default(0)
  status         String            @default("DRAFT") // DRAFT, PAID, OVERDUE
  journalEntryId String?           @unique // Link to the auto-generated JE
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer       Customer          @relation(fields: [customerId], references: [id])
  journalEntry   JournalEntry?     @relation("InvoiceJournal", fields: [journalEntryId], references: [id])
  lineItems      InvoiceLineItem[]
}

model InvoiceLineItem {
  id        String   @id @default(uuid())
  invoiceId String
  itemId    String
  quantity  Int      @default(1)
  unitPrice Float    // Price at the time of sale
  total     Float

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id])
}

// ------------------------------------------------------
// Phase 4: Bank Feeds & Automation
// ------------------------------------------------------

model BankTransaction {
  id                String       @id @default(uuid())
  date              DateTime
  description       String
  amount            Float        // Positive for incoming (deposit), negative for outgoing (withdrawal)
  status            String       @default("PENDING") // PENDING, RECONCILED, IGNORED

  // AI/Rule-based categorization suggestion
  suggestedAccountId String?     // The ID of the account the AI thinks this belongs to
  suggestedAction    String?     // e.g., "Expense", "Revenue", "Transfer"
  confidenceScore    Float       @default(0.0) // 0.0 to 1.0

  journalEntryId    String?      @unique
  journalEntry      JournalEntry? @relation("BankJournal", fields: [journalEntryId], references: [id])

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}
